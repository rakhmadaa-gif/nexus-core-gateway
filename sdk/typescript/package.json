{
  "name": "nexus-gateway-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Nexus Gateway — M2M Legal-Code Services for Web3. Native tool wrappers for LangChain.js and Vercel AI SDK.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./langchain": {
      "import": "./dist/langchain.js",
      "types": "./dist/langchain.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "echo 'No tests yet'",
    "example": "npx tsx examples/langchain_example.ts"
  },
  "keywords": [
    "nexus",
    "gateway",
    "smart-contract",
    "solidity",
    "legal-tech",
    "web3",
    "blockchain",
    "polygon",
    "erc20",
    "erc721",
    "digital-twin",
    "bilingual",
    "supabase",
    "m2m",
    "api",
    "legal-contract",
    "langchain",
    "crewai",
    "vercel-ai"
  ],
  "author": "Nexus.Legal.ContractDrafter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0",
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "homepage": "https://github.com/rakhmadaa-gif/nexus-core-gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakhmadaa-gif/nexus-core-gateway.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/rakhmadaa-gif/nexus-core-gateway/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
